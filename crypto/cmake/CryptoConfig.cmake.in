@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(GmSSL CONFIG REQUIRED)
if(NOT TARGET GmSSL::GmSSL)
  message(FATAL_ERROR "Installed Crypto requires the pinned GmSSL::GmSSL provider")
endif()
find_dependency(ASN1 0.1 CONFIG REQUIRED)
if(NOT TARGET Salts::ASN1)
  message(FATAL_ERROR "Installed Crypto requires standalone Salts::ASN1")
endif()
# One installed native archive, one public target. No split aliases.
get_property(_source GLOBAL PROPERTY SALTS_CRYPTO_PACKAGE_OWNER)
if(TARGET Salts::Crypto)
  if(NOT _source STREQUAL "${CMAKE_CURRENT_LIST_DIR}")
    message(FATAL_ERROR "Salts::Crypto already has another source owner")
  endif()
else()
  include("${CMAKE_CURRENT_LIST_DIR}/CryptoTargets.cmake")
  set_property(GLOBAL PROPERTY SALTS_CRYPTO_PACKAGE_OWNER "${CMAKE_CURRENT_LIST_DIR}")
endif()
get_target_property(_kind Salts::Crypto TYPE)
get_target_property(_imported Salts::Crypto IMPORTED)
if(NOT _imported OR NOT _kind STREQUAL "STATIC_LIBRARY")
  message(FATAL_ERROR "Crypto SDK requires exactly one imported STATIC Salts::Crypto")
endif()
foreach(_split IN ITEMS Salts::TLS Salts::TLSHost Salts::TLSCipherBIO Salts::CryptoProvider Crypto::ASN1)
  if(TARGET "${_split}")
    message(FATAL_ERROR "Noncanonical split Crypto target: ${_split}")
  endif()
endforeach()
unset(_source)
unset(_kind)
unset(_imported)
unset(_split)
check_required_components(Crypto)
