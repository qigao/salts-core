@PACKAGE_INIT@
# A single provider-neutral static library; no compatibility aliases.
if(TARGET Salts::ASN1)
  get_property(_owner GLOBAL PROPERTY SALTS_ASN1_PACKAGE_OWNER)
  if(NOT _owner STREQUAL "${CMAKE_CURRENT_LIST_DIR}")
    message(FATAL_ERROR "Salts::ASN1 already has a different source owner")
  endif()
else()
  include("${CMAKE_CURRENT_LIST_DIR}/ASN1Targets.cmake")
  set_property(GLOBAL PROPERTY SALTS_ASN1_PACKAGE_OWNER "${CMAKE_CURRENT_LIST_DIR}")
endif()
get_target_property(_type Salts::ASN1 TYPE)
get_target_property(_imported Salts::ASN1 IMPORTED)
if(NOT _imported OR NOT _type STREQUAL "STATIC_LIBRARY")
  message(FATAL_ERROR "Salts::ASN1 requires one imported static archive")
endif()
foreach(_old IN ITEMS Salts::CryptoASN1 SaltsCore::ASN1 Crypto::ASN1 SaltsNet::Asn1Parser)
  if(TARGET "${_old}")
    message(FATAL_ERROR "Duplicate/legacy ASN.1 owner: ${_old}")
  endif()
endforeach()
unset(_owner)
unset(_type)
unset(_imported)
unset(_old)
check_required_components(ASN1)
