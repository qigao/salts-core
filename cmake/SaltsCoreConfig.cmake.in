@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)

# Native first-party modules retain their own export sets in this SDK. Import
# those exact sibling packages, never an unrelated installed Crypto repository.
# Set normal variables before lookup so a cached path for another SDK cannot
# outrank this exact installation. Keep ASN1_DIR available to Crypto's nested
# find_dependency, including under an Android/iOS toolchain's find-root rules.
get_filename_component(ASN1_DIR
  "${CMAKE_CURRENT_LIST_DIR}/../ASN1" REALPATH)
find_dependency(ASN1 0.1 CONFIG REQUIRED
  PATHS "${ASN1_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
if(@SALTSCORE_CONFIG_HAS_CRYPTO@)
  get_filename_component(Crypto_DIR
    "${CMAKE_CURRENT_LIST_DIR}/../Crypto" REALPATH)
  find_dependency(Crypto 0.1 CONFIG REQUIRED
    PATHS "${Crypto_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
endif()

# Reject a pre-existing legacy Salts runtime owner instead of silently accepting
# colliding Salts:: targets from a different binary or SDK.
get_property(_salts_core_owner GLOBAL PROPERTY SALTS_CORE_PACKAGE_OWNER)
if(TARGET Salts::Core AND NOT _salts_core_owner STREQUAL "${CMAKE_CURRENT_LIST_DIR}")
  message(FATAL_ERROR "Salts::Core is already owned by another package; mixed native owners forbidden")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SaltsCoreTargets.cmake")
set_property(GLOBAL PROPERTY SALTS_CORE_PACKAGE_OWNER "${CMAKE_CURRENT_LIST_DIR}")
foreach(_salts_core_required IN ITEMS Core Platform Concurrency Coroutine NativeIO ASN1)
  if(NOT TARGET "Salts::${_salts_core_required}")
    message(FATAL_ERROR "SaltsCore SDK missing required Salts::${_salts_core_required} target")
  endif()
endforeach()
unset(_salts_core_owner)
unset(_salts_core_required)
check_required_components(SaltsCore)
