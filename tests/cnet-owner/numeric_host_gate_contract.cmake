cmake_minimum_required(VERSION 3.20)
# Cross-platform, process-real negative regression against a CTest fail-open.
set(_case "owns the resolve to TCP connect state transition")
if(DEFINED MOCK_MODE)
  if(NOT MOCK_MODE STREQUAL "missing_name")
    message(STATUS "${_case}")
  endif()
  if(MOCK_MODE STREQUAL "empty")
    message(STATUS "0 passed, 0 failed, 0 skipped, 11 filtered, 0 todo, 0 assertions.")
  elseif(MOCK_MODE STREQUAL "multiple")
    message(STATUS "2 passed, 0 failed, 0 skipped, 9 filtered, 0 todo, 2 assertions.")
  else()
    message(STATUS "1 passed, 0 failed, 0 skipped, 10 filtered, 0 todo, 1 assertions.")
  endif()
  if(MOCK_MODE STREQUAL "exit_nonzero")
    message(FATAL_ERROR "Simulated test returned failure despite matching case and PASS summary")
  endif()
  return()
endif()
set(_gate "${CMAKE_CURRENT_LIST_DIR}/verify_numeric_host_case.cmake")
foreach(_mode IN ITEMS success exit_nonzero empty multiple missing_name)
  set(_mock "${CMAKE_COMMAND};-DMOCK_MODE=${_mode};-P;${CMAKE_CURRENT_LIST_FILE}")
  execute_process(COMMAND "${CMAKE_COMMAND}"
      "-DCNET_NUMERIC_HOST_COMMAND=${_mock}" -P "${_gate}"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 8)
  if(_mode STREQUAL "success")
    if(NOT "${_status}" STREQUAL "0")
      message(FATAL_ERROR "Gate falsely rejected valid case\n${_stdout}\n${_stderr}")
    endif()
  elseif("${_status}" STREQUAL "0")
    message(FATAL_ERROR "Gate falsely accepted ${_mode}\n${_stdout}\n${_stderr}")
  endif()
endforeach()
message(STATUS "PASS: nonzero exit, empty/multiple selection and missing case rejected")
