
cmake_minimum_required(VERSION 3.20)

set(TARGET_NAME salts_serial)
set(EXAMPLES_TARGET_NAME ${TARGET_NAME}_examples)
set(SALTS_SERIAL_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
set(SALTS_SERIAL_BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}")

set(SALTS_SERIAL_SOURCES
    salts_serial.c)

set(SALTS_SERIAL_PLATFORM_LIBS)
set(SALTS_SERIAL_INSTALL_HEADERS salts_serial.h)

if(WIN32)
  list(APPEND SALTS_SERIAL_SOURCES backend_win32.c)
  list(APPEND SALTS_SERIAL_PLATFORM_LIBS setupapi cfgmgr32)
else()
  list(APPEND SALTS_SERIAL_SOURCES backend_posix.c)
endif()

configure_file(
  ${CMAKE_CURRENT_SOURCE_DIR}/salts_serial.h
  ${CMAKE_CURRENT_BINARY_DIR}/include/salts_serial.h
  COPYONLY)

add_library(${TARGET_NAME} SHARED
  ${SALTS_SERIAL_SOURCES}
  ${SALTS_SERIAL_INSTALL_HEADERS})
add_library(Salts::Serial ALIAS ${TARGET_NAME})

target_include_directories(${TARGET_NAME}
  PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/include>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
  PRIVATE
    ${CMAKE_CURRENT_BINARY_DIR}
    ${CMAKE_CURRENT_SOURCE_DIR})

target_link_libraries(${TARGET_NAME}
  PUBLIC Salts::Core
  PRIVATE Salts::CSTL ${SALTS_SERIAL_PLATFORM_LIBS})

set_target_properties(${TARGET_NAME} PROPERTIES
  C_STANDARD 11
  C_STANDARD_REQUIRED ON
  DEFINE_SYMBOL SALTS_SERIAL_EXPORTS
  OUTPUT_NAME salts_serial
  C_VISIBILITY_PRESET hidden
  VISIBILITY_INLINES_HIDDEN ON
  POSITION_INDEPENDENT_CODE ON)

if(MSVC)
  target_compile_options(${TARGET_NAME} PRIVATE /wd4996)
else()
  target_compile_options(${TARGET_NAME} PRIVATE -Wall -Wextra)
endif()

cmake_config_target(
  ${TARGET_NAME}
  FOLDER "salts_serial"
  EXPORT_NAME Serial)

install(
  TARGETS ${TARGET_NAME}
  EXPORT SaltsUtilsTargets
  LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
  ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
  RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})

install(FILES ${SALTS_SERIAL_INSTALL_HEADERS} DESTINATION include)

if(BUILD_TESTS)
  add_subdirectory(test)
endif()

if(BUILD_EXAMPLES)
  add_subdirectory(examples)
endif()
