# Resolve the runtime belonging to the actual selected Windows library. A
# MinGW provider may be static even when the vcpkg triplet prefers dynamic
# linkage; in that case there is deliberately no runtime to stage.
# This is package-path admission; real PE linkage is exercised by Windows CI.
function(saltscore_usb_windows_provider_files out_runtime out_copyright)
  cmake_parse_arguments(PROVIDER "" "" "LIBRARIES;INCLUDE_DIRS" ${ARGN})
  set(_providers)
  foreach(_library IN LISTS PROVIDER_LIBRARIES)
    get_filename_component(_name "${_library}" NAME)
    string(TOLOWER "${_name}" _name_lower)
    if(IS_ABSOLUTE "${_library}" AND
       (_name_lower MATCHES "^(lib)?usb-1\\.0\\.lib$" OR
        _name_lower MATCHES "^(lib)?usb-1\\.0\\.dll\\.a$" OR
        _name_lower MATCHES "^(lib)?usb-1\\.0\\.a$"))
      if(NOT EXISTS "${_library}" OR IS_DIRECTORY "${_library}")
        message(FATAL_ERROR "Windows USB selected library is missing: ${_library}")
      endif()
      file(REAL_PATH "${_library}" _provider)
      list(APPEND _providers "${_provider}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _providers)
  list(LENGTH _providers _provider_count)
  if(NOT _provider_count EQUAL 1)
    message(FATAL_ERROR "Windows USB requires one selected libusb library")
  endif()
  list(GET _providers 0 _provider)
  get_filename_component(_library_dir "${_provider}" DIRECTORY)
  get_filename_component(_library_dir_name "${_library_dir}" NAME)
  if(NOT _library_dir_name STREQUAL "lib")
    message(FATAL_ERROR "Windows USB import library must use its provider's lib directory")
  endif()
  get_filename_component(_binary_prefix "${_library_dir}" DIRECTORY)
  get_filename_component(_binary_prefix_name "${_binary_prefix}" NAME)
  if(_binary_prefix_name STREQUAL "debug")
    get_filename_component(_provider_prefix "${_binary_prefix}" DIRECTORY)
  else()
    set(_provider_prefix "${_binary_prefix}")
  endif()

  set(_headers)
  foreach(_include IN LISTS PROVIDER_INCLUDE_DIRS)
    if(EXISTS "${_include}/libusb.h" AND NOT IS_DIRECTORY "${_include}/libusb.h")
      file(REAL_PATH "${_include}/libusb.h" _header)
      list(APPEND _headers "${_header}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _headers)
  list(LENGTH _headers _header_count)
  if(NOT _header_count EQUAL 1)
    message(FATAL_ERROR "Windows USB requires one selected provider libusb.h")
  endif()
  list(GET _headers 0 _header)
  file(RELATIVE_PATH _header_relative "${_provider_prefix}" "${_header}")
  if(NOT _header_relative MATCHES "^include/(libusb-1\\.0/)?libusb\\.h$")
    message(FATAL_ERROR "Windows USB header and import library use different provider prefixes")
  endif()

  set(_copyright "${_provider_prefix}/share/libusb/copyright")
  if(NOT EXISTS "${_copyright}" OR IS_DIRECTORY "${_copyright}")
    message(FATAL_ERROR "Windows USB selected provider license is missing: ${_copyright}")
  endif()
  file(REAL_PATH "${_copyright}" _copyright)
  file(RELATIVE_PATH _copyright_relative "${_provider_prefix}" "${_copyright}")
  if(NOT _copyright_relative STREQUAL "share/libusb/copyright")
    message(FATAL_ERROR "Windows USB license escapes the selected provider prefix")
  endif()

  get_filename_component(_provider_name "${_provider}" NAME)
  string(TOLOWER "${_provider_name}" _provider_name_lower)
  set(_runtime "")
  if(_provider_name_lower MATCHES "\\.lib$")
    get_filename_component(_stem "${_provider}" NAME_WLE)
    set(_runtime_name "${_stem}.dll")
  elseif(_provider_name_lower MATCHES "\\.dll\\.a$")
    string(REGEX REPLACE "\\.dll\\.a$" ".dll" _runtime_name "${_provider_name}")
  endif()
  if(DEFINED _runtime_name)
    set(_runtime "${_binary_prefix}/bin/${_runtime_name}")
    if(NOT EXISTS "${_runtime}" OR IS_DIRECTORY "${_runtime}")
      message(FATAL_ERROR "Windows USB selected provider runtime is missing: ${_runtime}")
    endif()
    file(REAL_PATH "${_runtime}" _runtime)
    file(RELATIVE_PATH _runtime_relative "${_binary_prefix}" "${_runtime}")
    if(NOT _runtime_relative STREQUAL "bin/${_runtime_name}")
      message(FATAL_ERROR "Windows USB runtime escapes the selected provider prefix")
    endif()
  endif()
  set(${out_runtime} "${_runtime}" PARENT_SCOPE)
  set(${out_copyright} "${_copyright}" PARENT_SCOPE)
endfunction()
