# Resolve the runtime belonging to the actual selected Windows import library.
# This is package-path admission; real PE linkage is exercised by Windows CI.
function(saltscore_usb_windows_provider_files out_runtime out_copyright)
  cmake_parse_arguments(PROVIDER "" "" "LIBRARIES;INCLUDE_DIRS" ${ARGN})
  set(_imports)
  foreach(_library IN LISTS PROVIDER_LIBRARIES)
    get_filename_component(_name "${_library}" NAME)
    string(TOLOWER "${_name}" _name_lower)
    if(IS_ABSOLUTE "${_library}" AND _name_lower MATCHES "^(lib)?usb-1\\.0\\.lib$")
      if(NOT EXISTS "${_library}" OR IS_DIRECTORY "${_library}")
        message(FATAL_ERROR "Windows USB selected import library is missing: ${_library}")
      endif()
      file(REAL_PATH "${_library}" _import)
      list(APPEND _imports "${_import}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _imports)
  list(LENGTH _imports _import_count)
  if(NOT _import_count EQUAL 1)
    message(FATAL_ERROR "Windows USB requires one selected libusb shared import library")
  endif()
  list(GET _imports 0 _import)
  get_filename_component(_library_dir "${_import}" DIRECTORY)
  get_filename_component(_library_dir_name "${_library_dir}" NAME)
  if(NOT _library_dir_name STREQUAL "lib")
    message(FATAL_ERROR "Windows USB import library must use its provider's lib directory")
  endif()
  get_filename_component(_binary_prefix "${_library_dir}" DIRECTORY)
  get_filename_component(_binary_prefix_name "${_binary_prefix}" NAME)
  if(_binary_prefix_name STREQUAL "debug")
    get_filename_component(_provider_prefix "${_binary_prefix}" DIRECTORY)
  else()
    set(_provider_prefix "${_binary_prefix}")
  endif()

  set(_headers)
  foreach(_include IN LISTS PROVIDER_INCLUDE_DIRS)
    if(EXISTS "${_include}/libusb.h" AND NOT IS_DIRECTORY "${_include}/libusb.h")
      file(REAL_PATH "${_include}/libusb.h" _header)
      list(APPEND _headers "${_header}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _headers)
  list(LENGTH _headers _header_count)
  if(NOT _header_count EQUAL 1)
    message(FATAL_ERROR "Windows USB requires one selected provider libusb.h")
  endif()
  list(GET _headers 0 _header)
  file(RELATIVE_PATH _header_relative "${_provider_prefix}" "${_header}")
  if(NOT _header_relative MATCHES "^include/(libusb-1\\.0/)?libusb\\.h$")
    message(FATAL_ERROR "Windows USB header and import library use different provider prefixes")
  endif()

  get_filename_component(_stem "${_import}" NAME_WLE)
  set(_runtime "${_binary_prefix}/bin/${_stem}.dll")
  set(_copyright "${_provider_prefix}/share/libusb/copyright")
  foreach(_required IN ITEMS _runtime _copyright)
    if(NOT EXISTS "${${_required}}" OR IS_DIRECTORY "${${_required}}")
      message(FATAL_ERROR "Windows USB selected provider runtime or license is missing: ${${_required}}")
    endif()
  endforeach()
  file(REAL_PATH "${_runtime}" _runtime)
  file(REAL_PATH "${_copyright}" _copyright)
  file(RELATIVE_PATH _runtime_relative "${_binary_prefix}" "${_runtime}")
  file(RELATIVE_PATH _copyright_relative "${_provider_prefix}" "${_copyright}")
  if(NOT _runtime_relative STREQUAL "bin/${_stem}.dll" OR
     NOT _copyright_relative STREQUAL "share/libusb/copyright")
    message(FATAL_ERROR "Windows USB runtime or license escapes the selected provider prefix")
  endif()
  set(${out_runtime} "${_runtime}" PARENT_SCOPE)
  set(${out_copyright} "${_copyright}" PARENT_SCOPE)
endfunction()
